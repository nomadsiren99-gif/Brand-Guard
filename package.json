  "repository": {
    "type": "git",
    "url": "git+https://github.com/anuzdhk/Brand-Guard.git"
  },
  "bugs": {
    "url": "https://github.com/anuzdhk/Brand-Guard/issues"
  },
  "homepage": "https://github.com/anuzdhk/Brand-Guard#readme",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.6",
    "vitest": "^1.3.1"
  },
  "dependencies": {
